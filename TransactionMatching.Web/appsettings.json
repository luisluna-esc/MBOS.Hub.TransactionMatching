{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Pagination": {
    "InitialPageSize": 10,
    "InitialPageNumber": 1
  },
  "Jwt": {
    "Key": "",
    "Issuer": "TransactionMatching.Web",
    "Audience": "TransactionMatching.Clients",
